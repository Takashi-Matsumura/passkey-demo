# WebAuthn Relying Party 設定
# 開発時のローカル実行用デフォルトは lib/webauthn.ts 内にハードコード済み。
# 本番ドメインで動かす場合のみ下記を .env.local にコピーして編集する。

# RP ID は scheme/port を含まないホスト名。localhost のときは "localhost"。
RP_ID=localhost

# Origin は scheme とポートを含む完全な値。
ORIGIN=http://localhost:3000

# セッション署名用シークレット (openssl rand -base64 32 で生成推奨)
SESSION_SECRET=replace-me-with-a-long-random-string
